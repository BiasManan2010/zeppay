# Copy to Render → Environment, not into the Flutter app.
# Local: export these then `npm start` (Node does not auto-load this file).

TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# Optional instead of Messaging Service:
# TWILIO_FROM=+1xxxxxxxxxx
# Optional Twilio Verify (used if set):
# TWILIO_VERIFY_SID=VAxxxxxxxx

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional extra salt for phone hashes:
# OTP_PEPPER=change-me

# Render sets PORT. Local default is 8787.
# PORT=8787
