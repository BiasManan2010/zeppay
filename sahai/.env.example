# Anthropic (Claude API for RAG chat)
ANTHROPIC_API_KEY=sk-ant-...

# Twilio SMS escalation
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
SUPERVISOR_PHONE=+919876543210

# Demo mode: log SMS instead of sending
SIMULATE_SMS=true

# Vector store: faiss (Windows-friendly) or chroma
VECTOR_BACKEND=faiss

# Escalation policy for research baselines (b1_no_uncertainty | b2_* | b3_fused)
ESCALATION_POLICY=b3_fused
UNCERTAINTY_DEFER_THRESHOLD=0.45

# Whisper model size: base (~150MB) or small/medium
WHISPER_MODEL=base

# Frontend API URL (for Vite)
VITE_API_BASE_URL=http://localhost:8000

# Production CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
